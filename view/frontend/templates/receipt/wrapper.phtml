use Magento\Framework\Escaper;
use Zero1\OpenPos\Block\ReceiptWrapper;

/** @var ReceiptWrapper $block */
/** @var Escaper $escaper */
?>
<div id="openpos-receipt">
    <script type="text/javascript">
        // The "Print receipt" button prints directly. This is kept for anything emitting the Magewire 'print' event.
        window.addEventListener('js-print', function() {
            window.print();
        });
    </script>
    <div id="wrapper">
        <div class="flex w-full justify-center my-6 py-6">
            <span class="text-2xl font-bold"><span>&#128515</span> <?= $escaper->escapeHtml(__('Order complete!')) ?></span>
        </div>
        <div class="flex flex-wrap w-full my-6 py-6 justify-center gap-4">
            <?php /* Not translated: i18n/en_GB.csv blanks "Print receipt" to hide Magento's own link on the checkout success page */ ?>
            <button class="btn btn-primary btn-secondary" type="button" onclick="window.print()">Print receipt</button>
            <?= $block->getChildHtml('print_actions') ?>
        </div>
        <div class="flex w-full my-6 py-6 justify-center">
            <input type="text" class="w-full text-lg leading-normal transition appearance-none text-grey-800 outline-none border form-input" placeholder="<?= $escaper->escapeHtmlAttr(__('Customer email address')) ?>" wire:model.defer="emailInput"/>
            <button type="button" wire:click="email" class="btn btn-primary btn-secondary w-full"><?= $escaper->escapeHtml(__('Email receipt')) ?></button>
        </div>
        <div class="flex w-full my-6 py-6">
            <button type="button" class="w-full underline font-bold" wire:click="newOrder"><?= $escaper->escapeHtml(__('Start new order')) ?></button>
            <a href="<?= $escaper->escapeUrl($block->getOrderViewUrl()) ?>" class="w-full underline font-bold text-center">
                <?= $escaper->escapeHtml(__('Open order details')) ?>
            </a>
        </div>
    </div>

    <div id="printed-receipt">
        <?= $block->getChildHtml('openpos.receipt.print'); ?>
    </div>

    <style>
        #printed-receipt {
            display: none;
        }
        #wrapper {
            display: block;
        }

        @media print {
            #printed-receipt {
                display: block;
            }
            #wrapper {
                display: none;
            }
        }
    </style>
</div>
